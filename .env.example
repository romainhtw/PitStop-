# ── Shopify App credentials ───────────────────────────────────────────────────
# All values come from your app in the Shopify Partner Dashboard:
#   https://partners.shopify.com → Apps → <your app> → App setup
#
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.vercel.app
SHOPIFY_SCOPES=read_products,read_locations,write_inventory

# Public key — safe to expose to the browser (used by App Bridge v4)
NEXT_PUBLIC_SHOPIFY_API_KEY=

# Optional: 32-byte base64 key for AES-256-GCM token encryption at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Leave blank to store tokens in plaintext (local dev only).
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# ── Firebase Admin ────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── PitStop auth ──────────────────────────────────────────────────────────────
PITSTOP_JWT_SECRET=
PITSTOP_PIN=
